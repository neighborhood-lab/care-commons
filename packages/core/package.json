{
  "name": "@folkcare/core",
  "version": "0.1.0",
  "description": "Folk Care Core - shared domain logic, database, and permissions",
  "//1": "════════════════════════════════════════════════════════════════",
  "//2": "⚠️  CORE ESM PACKAGE - DO NOT CHANGE type:module",
  "//3": "════════════════════════════════════════════════════════════════",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./demo": {
      "types": "./dist/demo/index.d.ts",
      "import": "./dist/demo/index.js",
      "default": "./dist/demo/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "import": "./dist/sync/index.js",
      "default": "./dist/sync/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./service/cache.service": {
      "types": "./dist/service/cache.service.d.ts",
      "import": "./dist/service/cache.service.js",
      "default": "./dist/service/cache.service.js"
    },
    "./constants/cache-keys": {
      "types": "./dist/constants/cache-keys.d.ts",
      "import": "./dist/constants/cache-keys.js",
      "default": "./dist/constants/cache-keys.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js",
      "default": "./dist/ai/index.js"
    }
  },
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc --composite false && tsc-alias -p tsconfig.json",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts --max-warnings 190 && npm run lint:sql",
    "lint:sql": "sql-lint --driver postgres migrations/*.sql || echo 'SQL lint completed'",
    "db:migrate": "cd ../.. && tsx packages/core/scripts/migrate.ts",
    "db:migrate:rollback": "cd ../.. && tsx packages/core/scripts/rollback.ts",
    "db:migrate:status": "cd ../.. && tsx packages/core/scripts/migrate-status.ts",
    "db:seed:demo": "cd ../.. && tsx packages/core/scripts/seed-demo.ts",
    "db:set-admin-password": "cd ../.. && tsx packages/core/scripts/set-admin-password.ts",
    "db:nuke": "cd ../.. && tsx packages/core/scripts/nuke.ts",
    "db:generate-types": "cd ../.. && tsx scripts/generate-db-types.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.2.0",
    "@opentelemetry/instrumentation": "^0.208.0",
    "@opentelemetry/instrumentation-http": "^0.208.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@sentry/node": "^10.32.1",
    "@sentry/profiling-node": "^10.32.1",
    "@types/express": "^5.0.5",
    "@types/papaparse": "^5.5.2",
    "@anthropic-ai/sdk": "^0.71.2",
    "bintrees": "^1.0.2",
    "date-fns": "^4.1.0",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "luxon": "^3.7.2",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "prom-client": "^15.1.3",
    "redis": "^5.9.0",
    "sanitize-html": "^2.17.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.12",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@ls-lint/ls-lint": "^2.3.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/sanitize-html": "^2.16.0",
    "@types/zxcvbn": "^4.4.5",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitest/coverage-v8": "^4.0.8",
    "eslint": "^9.39.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "isomorphic-dompurify": "^2.35.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
