{
  "name": "@folkcare/mobile",
  "version": "0.1.0",
  "description": "Folk Care Mobile - React Native app for caregivers with offline EVV",
  "main": "index.ts",
  "//1": "════════════════════════════════════════════════════════════════",
  "//2": "⚠️  MOBILE PACKAGE - React Native with Expo",
  "//3": "Offline-first mobile app for caregivers with EVV compliance",
  "//4": "════════════════════════════════════════════════════════════════",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "expo start --dev-client",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "detox test --configuration ios.sim.debug",
    "test:e2e:build": "detox build --configuration ios.sim.debug",
    "test:e2e:debug": "detox test --configuration ios.sim.debug --loglevel verbose",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 100",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@folkcare/core": "^0.1.0",
    "@folkcare/time-tracking-evv": "^0.1.0",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.8.11",
    "@react-navigation/native": "^7.1.24",
    "@react-navigation/native-stack": "^7.8.5",
    "@sentry/react-native": "~7.7.0",
    "@tanstack/react-query": "^5.90.12",
    "date-fns": "^4.1.0",
    "expo": "~54.0.27",
    "expo-battery": "~10.0.8",
    "expo-camera": "^17.0.10",
    "expo-constants": "~18.0.10",
    "expo-crypto": "~15.0.8",
    "expo-device": "~8.0.10",
    "expo-file-system": "^19.0.17",
    "expo-image-manipulator": "^14.0.8",
    "expo-image-picker": "^17.0.9",
    "expo-local-authentication": "~17.0.8",
    "expo-localization": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-modules-core": "^3.0.25",
    "expo-notifications": "~0.32.14",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "^14.0.8",
    "expo-status-bar": "~3.0.9",
    "fast-base64-decode": "^2.0.0",
    "fbjs": "^3.0.5",
    "react": "19.2.1",
    "react-native": "0.82.1",
    "react-native-gesture-handler": "~2.29.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-maps": "^1.26.19",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.18.0",
    "react-native-signature-canvas": "^5.0.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.0",
    "sentry-expo": "^7.2.0",
    "styleq": "^0.2.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@eslint/js": "^9.39.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitest/coverage-v8": "^4.0.13",
    "detox": "^20.45.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  },
  "engines": {
    "node": "22.x"
  }
}
