# Folk Care - Docker Environment Configuration
#
# Copy this file to .env.docker and configure for your deployment:
#   cp .env.docker.example .env.docker
#
# Then start with:
#   docker compose -f docker-compose.production.yml --env-file .env.docker up -d

# ============================================
# Required Configuration
# ============================================

# Application port (default: 3000)
PORT=3000

# JWT secret for authentication (CHANGE THIS!)
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-secure-random-string

# ============================================
# Database Configuration
# ============================================

# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-secure-password
POSTGRES_DB=folkcare

# ============================================
# Optional: AI Features (Claude API)
# ============================================

# Anthropic API key for AI features
# Get one at: https://console.anthropic.com/
# Without this, AI features (medication interactions, smart scheduling) are disabled
ANTHROPIC_API_KEY=

# ============================================
# Optional: Email Configuration (Resend)
# ============================================

# Resend API key for sending emails
# Get one at: https://resend.com/
# Without this, email notifications are disabled
RESEND_API_KEY=

# ============================================
# Optional: Monitoring & Analytics
# ============================================

# Sentry DSN for error tracking
# Get one at: https://sentry.io/
SENTRY_DSN=

# ============================================
# Optional: Stripe (Billing)
# ============================================

# Stripe API keys (only needed if using paid features)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# SSL/HTTPS Configuration (for proxy profile)
# ============================================

# Domain name for SSL certificate
DOMAIN_NAME=localhost

# ============================================
# Advanced Configuration
# ============================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable demo mode (pre-loads sample data)
DEMO_MODE=false

# Timezone for scheduling features
TZ=America/Chicago
