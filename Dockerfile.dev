# Development Environment Dockerfile
# Based on Node.js 22 Debian Slim with common dev tools pre-installed

FROM node:22-slim

# Install essential development tools
RUN apt-get update && apt-get install -y \
    bash \
    curl \
    git \
    vim \
    python3 \
    python3-pip \
    ripgrep \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Set bash as default shell
SHELL ["/bin/bash", "-c"]

# Grant sudo access to existing 'node' user (UID 1000)
RUN echo "node ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Switch to node user
USER node
WORKDIR /home/node

# Create .bashrc with nvm configuration
RUN echo 'export NVM_DIR="$HOME/.nvm"' >> /home/node/.bashrc \
    && echo '[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm' >> /home/node/.bashrc \
    && echo '[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion' >> /home/node/.bashrc

# Set working directory
WORKDIR /workspace

# Keep container running
CMD ["sleep", "infinity"]
