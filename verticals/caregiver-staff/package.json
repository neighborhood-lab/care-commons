{
  "name": "@folkcare/caregiver-staff",
  "version": "0.1.0",
  "//1": "════════════════════════════════════════════════════════════════",
  "//2": "⚠️  ESM VERTICAL - type:module required",
  "//3": "════════════════════════════════════════════════════════════════",
  "type": "module",
  "description": "Folk Care Caregiver & Staff Management - workforce coordination and credentialing",
  "engines": {
    "node": "22.x"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --composite false && tsc-alias -p tsconfig.json",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts --max-warnings 10"
  },
  "dependencies": {
    "@folkcare/core": "^0.1.0",
    "date-fns": "^4.1.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "keywords": [
    "folkcare",
    "caregiver",
    "staff-management",
    "home-care"
  ],
  "author": "Neighborhood Lab",
  "license": "AGPL-3.0"
}
