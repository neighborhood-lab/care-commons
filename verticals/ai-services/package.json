{
  "name": "@folkcare/ai-services",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc --composite false && tsc-alias -p tsconfig.json",
    "dev": "tsc --watch",
