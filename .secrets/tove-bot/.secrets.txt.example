# Tove Bot Secrets
# Copy this file to .secrets.txt and fill in values

# GitHub Personal Access Token (for tove-bot account)
GITHUB_TOKEN=ghp_...

# Discord Webhook URL (shared webhook, same for all agents)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Vercel Token (optional, for deployments)
VERCEL_TOKEN=...
